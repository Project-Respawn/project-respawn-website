    "Denied": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ProjectRespawn-Core-Production-Denied",
        "Namespace": "ProjectRespawn/Core",
        "MetricName": "Denied",
        "Dimensions": [
          {
            "Name": "Environment",
            "Value": "Production"
          }
        ],
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 20,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
