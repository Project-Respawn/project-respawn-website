    },
    "Contracts": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "ProjectRespawn-Core-Production-Contracts",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 10,
        "Role": {
          "Fn::GetAtt": [
            "Runtime",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": "cdk-hnb659fds-assets-058264289478-eu-north-1",
          "S3Key": "production/fecdc0327a5f75c8be4f9e4f280776b6908f646dfdffdf6bee4e61e5e8126503.zip"
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "Logs"
          },
          "LogFormat": "JSON"
        },
        "Environment": {
          "Variables": {
            "CORE_ENVIRONMENT": "{\"contractVersion\":\"environment.v1\",\"environment\":\"Production\",\"account\":\"058264289478\",\"region\":\"eu-north-1\",\"poolId\":\"eu-north-1_Uufjxul58\",\"clientId\":\"2kc81ph5mgvo9eu2qjvmif5u8g\",\"issuer\":\"https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_Uufjxul58\"}",
            "CORE_CURSOR_SECRET_ARN": {
              "Fn::ImportValue": "ProjectRespawn-Core-Production-CursorSecretArn"
            }
          }
        }
      }
    },
    "Errors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ProjectRespawn-Core-Production-Errors",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Contracts"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "Throttles": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ProjectRespawn-Core-Production-Throttles",
        "Namespace": "AWS/Lambda",
        "MetricName": "Throttles",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Contracts"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "DependencyFailures": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ProjectRespawn-Core-Production-DependencyFailures",
