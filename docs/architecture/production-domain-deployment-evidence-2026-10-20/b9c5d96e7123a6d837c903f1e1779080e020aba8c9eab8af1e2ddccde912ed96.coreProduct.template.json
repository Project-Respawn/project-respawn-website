      "Properties": {
        "RoleName": "ProjectRespawn-Core-Production-Contracts",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "PermissionsBoundary": {
          "Fn::ImportValue": "ProjectRespawn-Core-Production-RuntimeBoundaryArn"
        },
        "Policies": [
          {
            "PolicyName": "ProductionRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Deny",
                  "NotAction": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "cognito-idp:AdminGetUser",
                    "cognito-idp:AdminListGroupsForUser",
                    "cognito-idp:ListUsers",
                    "secretsmanager:GetSecretValue",
                    "kms:Decrypt"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Production/core/contracts:*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:AdminGetUser",
                    "cognito-idp:AdminListGroupsForUser",
                    "cognito-idp:ListUsers"
                  ],
                  "Resource": "arn:aws:cognito-idp:eu-north-1:058264289478:userpool/eu-north-1_Uufjxul58"
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Fn::ImportValue": "ProjectRespawn-Core-Production-CursorSecretArn"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": "cognito-idp:*",
                  "NotResource": "arn:aws:cognito-idp:eu-north-1:058264289478:userpool/eu-north-1_Uufjxul58"
                },
                {
                  "Effect": "Deny",
                  "Action": "logs:*",
                  "NotResource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Production/core/contracts:*"
                },
                {
                  "Effect": "Deny",
                  "Action": "secretsmanager:*",
                  "NotResource": {
                    "Fn::ImportValue": "ProjectRespawn-Core-Production-CursorSecretArn"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": "kms:*",
                  "NotResource": [
                    "arn:aws:kms:eu-north-1:058264289478:key/13ae83f9-bc5f-4486-a013-e07b9d7d52e7",
                    "arn:aws:kms:eu-north-1:058264289478:key/8802a37a-f981-4384-b538-fdb4f7aba74a"
                  ]
                },
                {
                  "Effect": "Deny",
                  "NotAction": [
                    "kms:Decrypt"
                  ],
                  "Resource": [
                    "arn:aws:kms:eu-north-1:058264289478:key/13ae83f9-bc5f-4486-a013-e07b9d7d52e7",
                    "arn:aws:kms:eu-north-1:058264289478:key/8802a37a-f981-4384-b538-fdb4f7aba74a"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/13ae83f9-bc5f-4486-a013-e07b9d7d52e7",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": "lambda.eu-north-1.amazonaws.com",
                      "kms:CallerAccount": "058264289478",
                      "kms:EncryptionContext:aws:lambda:FunctionArn": [
                        "arn:aws:lambda:eu-north-1:058264289478:function:ProjectRespawn-Core-Production-Contracts"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/8802a37a-f981-4384-b538-fdb4f7aba74a",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": "secretsmanager.eu-north-1.amazonaws.com",
                      "kms:CallerAccount": "058264289478",
                      "kms:EncryptionContext:SecretARN": {
                        "Fn::ImportValue": "ProjectRespawn-Core-Production-CursorSecretArn"
                      }
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "kms:Decrypt"
                  ],
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/13ae83f9-bc5f-4486-a013-e07b9d7d52e7",
                  "Condition": {
                    "StringNotEquals": {
                      "kms:ViaService": "lambda.eu-north-1.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "kms:Decrypt"
                  ],
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/13ae83f9-bc5f-4486-a013-e07b9d7d52e7",
                  "Condition": {
                    "StringNotEquals": {
                      "kms:CallerAccount": "058264289478"
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "kms:Decrypt"
                  ],
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/8802a37a-f981-4384-b538-fdb4f7aba74a",
                  "Condition": {
                    "StringNotEquals": {
                      "kms:ViaService": "secretsmanager.eu-north-1.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "kms:Decrypt"
                  ],
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/8802a37a-f981-4384-b538-fdb4f7aba74a",
                  "Condition": {
                    "StringNotEquals": {
                      "kms:CallerAccount": "058264289478"
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": "kms:Decrypt",
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/13ae83f9-bc5f-4486-a013-e07b9d7d52e7",
                  "Condition": {
                    "StringNotEquals": {
                      "kms:EncryptionContext:aws:lambda:FunctionArn": [
                        "arn:aws:lambda:eu-north-1:058264289478:function:ProjectRespawn-Core-Production-Contracts"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": "kms:Decrypt",
                  "Resource": "arn:aws:kms:eu-north-1:058264289478:key/8802a37a-f981-4384-b538-fdb4f7aba74a",
                  "Condition": {
                    "StringNotEquals": {
                      "kms:EncryptionContext:SecretARN": {
                        "Fn::ImportValue": "ProjectRespawn-Core-Production-CursorSecretArn"
                      }
                    }
                  }
                }
