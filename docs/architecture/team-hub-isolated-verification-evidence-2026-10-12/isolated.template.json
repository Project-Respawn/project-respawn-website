                    "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Isolated-20261012v1-Operational/index/ByTeamStatus"
                  ]
                },
                {
                  "Effect": "Deny",
                  "Action": "dynamodb:*",
                  "Resource": "*",
                  "Condition": {
                    "StringNotEquals": {
                      "aws:RequestedRegion": "eu-north-1"
                    }
                  }
                },
