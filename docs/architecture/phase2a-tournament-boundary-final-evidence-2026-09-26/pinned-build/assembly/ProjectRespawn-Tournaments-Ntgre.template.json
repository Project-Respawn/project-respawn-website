   }
  },
  "ContractVersion": {
   "Value": "tournament-preview.v1"
  },
  "DeploymentRevision": {
   "Value": "b75a91494c03606d825e234a65d295c184067820cd77dfc84e11a2c83484ae2f"
  },
  "CoreIdentitySha256": {
   "Value": "9bea68ab5781eeb7265c363fd6baac78d1e3e032196f9aa209bc3780644a6b9e"
  }
 },
 "Parameters": {
