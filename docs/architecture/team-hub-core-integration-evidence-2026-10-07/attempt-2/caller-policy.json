{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "NotAction": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "iam:PassRole",
        "cloudformation:ListStackResources",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListChangeSets",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListChangeSets"
      ],
      "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-TeamHub-Ntgre/*"
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-TeamHub-Ntgre/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::058264289478:role/ProjectRespawn-TeamHub-Ntgre-ReadProofExecution",
          "cloudformation:TemplateUrl": [
            "https://cdk-hnb659fds-assets-058264289478-eu-north-1.s3.eu-north-1.amazonaws.com/team-hub/parity/d9e47021ffc55ee99c9477f0ff00590258f10e51375d7f8065afbf28f26c51c2.template.json",
            "https://cdk-hnb659fds-assets-058264289478-eu-north-1.s3.eu-north-1.amazonaws.com/team-hub/core-integration/dcf59fa854310f7cbbc589622eacac4fe06eb80dfeda8e269d19d4b32378f51a.template.json"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:ExecuteChangeSet",
      "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-TeamHub-Ntgre/*"
    },
    {
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "NotResource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-TeamHub-Ntgre/*"
    },
    {
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-TeamHub-Ntgre-ReadProofExecution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "NotResource": "arn:aws:iam::058264289478:role/ProjectRespawn-TeamHub-Ntgre-ReadProofExecution"
    },
    {
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/team-hub/parity/d9e47021ffc55ee99c9477f0ff00590258f10e51375d7f8065afbf28f26c51c2.template.json",
        "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/da4d9e570523cbbdcff21572d059f18227d03c12482620e916752f2863b87da1.zip",
        "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/team-hub/core-integration/dcf59fa854310f7cbbc589622eacac4fe06eb80dfeda8e269d19d4b32378f51a.template.json"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/team-hub/parity/d9e47021ffc55ee99c9477f0ff00590258f10e51375d7f8065afbf28f26c51c2.template.json",
        "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/da4d9e570523cbbdcff21572d059f18227d03c12482620e916752f2863b87da1.zip",
        "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/team-hub/core-integration/dcf59fa854310f7cbbc589622eacac4fe06eb80dfeda8e269d19d4b32378f51a.template.json"
      ]
    }
  ]
}
