                  "NotResource": "arn:aws:secretsmanager:eu-north-1:058264289478:secret:ProjectRespawn-Core-Ntgre-Cursor-??????"
                },
                {
                  "Effect": "Deny",
                  "Action": "kms:Decrypt",
