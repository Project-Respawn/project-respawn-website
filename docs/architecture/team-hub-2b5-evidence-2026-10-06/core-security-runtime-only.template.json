{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Runtime boundary candidate only; deployment security remains a blocker",
  "Resources": {
    "RuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "ProjectRespawn-Core-Ntgre-RuntimeBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "NotAction": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "kms:Decrypt",
                "cognito-idp:AdminGetUser",
                "cognito-idp:AdminListGroupsForUser",
                "cognito-idp:ListUsers",
                "secretsmanager:GetSecretValue"
              ],
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Action": "kms:Decrypt",
              "NotResource": "arn:aws:kms:eu-north-1:058264289478:key/*"
            },
            {
              "Effect": "Deny",
              "Action": "kms:Decrypt",
              "Resource": "*",
              "Condition": {
                "ForAllValues:StringNotEquals": {
                  "kms:ResourceAliases": [
                    "alias/aws/lambda"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": "arn:aws:kms:eu-north-1:058264289478:key/*",
              "Condition": {
                "ForAnyValue:StringEquals": {
                  "kms:ResourceAliases": [
                    "alias/aws/lambda"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/core/contracts:*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "cognito-idp:AdminGetUser",
                "cognito-idp:AdminListGroupsForUser",
                "cognito-idp:ListUsers"
              ],
              "Resource": "arn:aws:cognito-idp:eu-north-1:058264289478:userpool/eu-north-1_n24iLL7QE"
            },
            {
              "Effect": "Deny",
              "Action": "cognito-idp:*",
              "NotResource": "arn:aws:cognito-idp:eu-north-1:058264289478:userpool/eu-north-1_n24iLL7QE"
            },
            {
              "Effect": "Allow",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": "arn:aws:secretsmanager:eu-north-1:058264289478:secret:ProjectRespawn-Core-Ntgre-Cursor-??????"
            }
          ]
        }
      }
    }
  }
}
