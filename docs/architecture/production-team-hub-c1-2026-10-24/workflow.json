{
  "Comment": "Fixed Production LEGACY_WRITER 1/1 conditional create; input discarded; no retries.",
  "StartAt": "DiscardInput",
  "TimeoutSeconds": 120,
  "States": {
    "DiscardInput": {
      "Type": "Pass",
      "Result": {},
      "Next": "ReadExisting"
    },
    "ReadExisting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "ProjectRespawn-TeamHub-Production-Journal",
        "Key": {
          "PK": {
            "S": "CONTROL#AUTHORITY"
          },
          "SK": {
            "S": "STATE"
          }
        },
        "ConsistentRead": true
      },
      "Next": "RequireAbsent"
    },
    "RequireAbsent": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Item.PK",
          "IsPresent": true,
          "Next": "AlreadyExists"
        }
      ],
      "Default": "CreateLegacy"
    },
    "AlreadyExists": {
      "Type": "Fail",
      "Error": "AuthorityAlreadyExists"
    },
    "CreateLegacy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "ProjectRespawn-TeamHub-Production-Journal",
        "Item": {
          "PK": {
            "S": "CONTROL#AUTHORITY"
          },
          "SK": {
            "S": "STATE"
          },
          "schemaVersion": {
            "S": "team-hub-authority.v1"
          },
          "mode": {
            "S": "LEGACY_WRITER"
          },
          "epoch": {
            "N": "1"
          },
          "version": {
            "N": "1"
          },
          "changedAt": {
            "S": "2026-10-24T08:44:53.810Z"
          },
          "changedBy": {
            "S": "production-team-hub-c1-executor"
          },
          "gateDigest": {
            "S": "5c310e8d7301d4119801116360ea6bb343ac26f07ac2a696bbaf5393418829e0"
          }
        },
        "ConditionExpression": "attribute_not_exists(PK) AND attribute_not_exists(SK)",
        "ReturnValues": "NONE"
      },
      "Next": "ReadBack"
    },
    "ReadBack": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "ProjectRespawn-TeamHub-Production-Journal",
        "Key": {
          "PK": {
            "S": "CONTROL#AUTHORITY"
          },
          "SK": {
            "S": "STATE"
          }
        },
        "ConsistentRead": true
      },
      "Next": "VerifyExact"
    },
    "VerifyExact": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.Item.PK.S",
              "StringEquals": "CONTROL#AUTHORITY"
            },
            {
              "Variable": "$.Item.SK.S",
              "StringEquals": "STATE"
            },
            {
              "Variable": "$.Item.schemaVersion.S",
              "StringEquals": "team-hub-authority.v1"
            },
            {
              "Variable": "$.Item.mode.S",
              "StringEquals": "LEGACY_WRITER"
            },
            {
              "Variable": "$.Item.epoch.N",
              "StringEquals": "1"
            },
            {
              "Variable": "$.Item.version.N",
              "StringEquals": "1"
            },
            {
              "Variable": "$.Item.changedAt.S",
              "StringEquals": "2026-10-24T08:44:53.810Z"
            },
            {
              "Variable": "$.Item.changedBy.S",
              "StringEquals": "production-team-hub-c1-executor"
            },
            {
              "Variable": "$.Item.gateDigest.S",
              "StringEquals": "5c310e8d7301d4119801116360ea6bb343ac26f07ac2a696bbaf5393418829e0"
            }
          ],
          "Next": "Done"
        }
      ],
      "Default": "Mismatch"
    },
    "Mismatch": {
      "Type": "Fail",
      "Error": "AuthorityReadbackMismatch"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
