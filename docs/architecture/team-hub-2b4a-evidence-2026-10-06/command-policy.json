{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyOwnedParityOperations",
      "Effect": "Deny",
      "NotAction": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "kms:Decrypt",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": "logs:*",
      "NotResource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/team-hub/parity-command:*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/team-hub/parity-command:*"
    },
    {
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "NotResource": "arn:aws:kms:eu-north-1:058264289478:key/*"
    },
    {
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringNotEquals": {
          "kms:ResourceAliases": [
            "alias/aws/lambda"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-north-1:058264289478:key/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": [
            "alias/aws/lambda"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Operational",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "TEAM#team:phase2b4-test-*",
            "SLUG#phase2b4-test-*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Journal",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "IDEMP#*#team:phase2b4-test-*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Operational",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "TEAM#team:phase2b4-test-*",
            "SLUG#phase2b4-test-*"
          ]
        },
        "ForAnyValue:StringEquals": {
          "dynamodb:EnclosingOperation": [
            "TransactWriteItems"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:ConditionCheckItem",
      "Resource": "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Operational",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "TEAM#team:phase2b4-test-*",
            "SLUG#phase2b4-test-*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Journal",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "TEAM#team:phase2b4-test-*",
            "IDEMP#*#team:phase2b4-test-*"
          ]
        },
        "ForAnyValue:StringEquals": {
          "dynamodb:EnclosingOperation": [
            "TransactWriteItems"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "dynamodb:*",
      "NotResource": [
        "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Operational",
        "arn:aws:dynamodb:eu-north-1:058264289478:table/ProjectRespawn-TeamHub-Ntgre-Journal"
      ]
    }
  ]
}
