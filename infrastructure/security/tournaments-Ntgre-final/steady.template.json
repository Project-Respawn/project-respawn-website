{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Final Phase 2A: IAM-only security bootstrap; API access logging deferred",
  "Parameters": {
    "TournamentApiId": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9]{10}$"
    }
  },
  "Resources": {
    "DeploymentPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "ProjectRespawn-Tournaments-Ntgre-DeployBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyReviewedOperations",
              "Effect": "Deny",
              "NotAction": [
                "cloudformation:DescribeStacks",
                "cloudformation:DescribeStackEvents",
                "cloudformation:DescribeStackResources",
                "cloudformation:ListStackResources",
                "cloudformation:GetTemplate",
                "cloudformation:GetTemplateSummary",
                "cloudformation:DescribeChangeSet",
                "cloudformation:ListChangeSets",
                "cloudformation:CreateChangeSet",
                "cloudformation:ExecuteChangeSet",
                "cloudformation:DeleteChangeSet",
                "iam:PassRole",
                "sts:GetCallerIdentity",
                "s3:GetObject",
                "s3:GetObjectVersion",
                "ssm:GetParameter",
                "ssm:GetParameters"
              ],
              "Resource": "*"
            },
            {
              "Sid": "DenyEveryOtherStack",
              "Effect": "Deny",
              "Action": "cloudformation:*",
              "NotResource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*"
            },
            {
              "Sid": "DenyWrongCfnRegion",
              "Effect": "Deny",
              "Action": "cloudformation:*",
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:RequestedRegion": "eu-north-1"
                }
              }
            },
            {
              "Sid": "InspectOnlyTournament",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeStacks",
                "cloudformation:DescribeStackEvents",
                "cloudformation:DescribeStackResources",
                "cloudformation:ListStackResources",
                "cloudformation:GetTemplate",
                "cloudformation:GetTemplateSummary",
                "cloudformation:DescribeChangeSet",
                "cloudformation:ListChangeSets"
              ],
              "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*"
            },
            {
              "Sid": "PrepareOnlyReviewedTemplate",
              "Effect": "Allow",
              "Action": "cloudformation:CreateChangeSet",
              "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*",
              "Condition": {
                "ArnEquals": {
                  "cloudformation:RoleArn": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution"
                },
                "StringEquals": {
                  "cloudformation:TemplateUrl": "https://cdk-hnb659fds-assets-058264289478-eu-north-1.s3.eu-north-1.amazonaws.com/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json"
                },
                "StringLike": {
                  "cloudformation:ChangeSetName": "ntgre-tournaments-*"
                }
              }
            },
            {
              "Sid": "ManageOnlyTournamentChangeSets",
              "Effect": "Allow",
              "Action": [
                "cloudformation:ExecuteChangeSet",
                "cloudformation:DeleteChangeSet"
              ],
              "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*",
              "Condition": {
                "StringLike": {
                  "cloudformation:ChangeSetName": "ntgre-tournaments-*"
                }
              }
            },
            {
              "Sid": "DenyPassingOtherRoles",
              "Effect": "Deny",
              "Action": "iam:PassRole",
              "NotResource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution"
            },
            {
              "Sid": "DenyPassingToOtherServices",
              "Effect": "Deny",
              "Action": "iam:PassRole",
              "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution",
              "Condition": {
                "StringNotEquals": {
                  "iam:PassedToService": "cloudformation.amazonaws.com"
                }
              }
            },
            {
              "Sid": "PassOnlyTournamentExecution",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "cloudformation.amazonaws.com"
                }
              }
            },
            {
              "Sid": "ReadOnlyApprovedTemplate",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
              ],
              "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json"
            },
            {
              "Sid": "DenyOtherArtifactReads",
              "Effect": "Deny",
              "Action": "s3:*",
              "NotResource": "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json"
            },
            {
              "Sid": "ReadBootstrapVersion",
              "Effect": "Allow",
              "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters"
              ],
              "Resource": "arn:aws:ssm:eu-north-1:058264289478:parameter/cdk-bootstrap/hnb659fds/version"
            },
            {
              "Sid": "CallerIdentity",
              "Effect": "Allow",
              "Action": "sts:GetCallerIdentity",
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Action": [
                "cognito-idp:*",
                "cognito-identity:*",
                "appsync:*",
                "dynamodb:*",
                "kms:*",
                "secretsmanager:*",
                "ecs:*",
                "ec2:*",
                "events:*",
                "firehose:*"
              ],
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Action": [
                "logs:PutResourcePolicy",
                "logs:DeleteResourcePolicy",
                "logs:CreateLogDelivery",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    },
    "ExecutionPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "ProjectRespawn-Tournaments-Ntgre-ExecutionBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "lambda:CreateFunction",
                "lambda:GetFunction",
                "lambda:GetFunctionConfiguration",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:DeleteFunction",
                "lambda:ListTags",
                "lambda:TagResource",
                "lambda:UntagResource",
                "lambda:GetPolicy",
                "lambda:AddPermission",
                "lambda:RemovePermission",
                "lambda:GetRuntimeManagementConfig",
                "lambda:GetFunctionRecursionConfig"
              ],
              "Resource": "arn:aws:lambda:eu-north-1:058264289478:function:ProjectRespawn-Tournaments-Ntgre-PreviewFunction-*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "cloudwatch:PutMetricAlarm",
                "cloudwatch:DeleteAlarms",
                "cloudwatch:DescribeAlarms",
                "cloudwatch:TagResource",
                "cloudwatch:UntagResource",
                "cloudwatch:ListTagsForResource"
              ],
              "Resource": [
                "arn:aws:cloudwatch:eu-north-1:058264289478:alarm:ProjectRespawn-Tournaments-Ntgre-PreviewErrors-*",
                "arn:aws:cloudwatch:eu-north-1:058264289478:alarm:ProjectRespawn-Tournaments-Ntgre-HttpErrors-*"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:DeleteLogGroup",
                "logs:PutRetentionPolicy",
                "logs:DeleteRetentionPolicy",
                "logs:TagResource",
                "logs:UntagResource",
                "logs:ListTagsForResource",
                "logs:DescribeLogStreams",
                "logs:GetDataProtectionPolicy"
              ],
              "Resource": [
                "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/tournaments/preview",
                "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/tournaments/preview:*"
              ]
            },
            {
              "Effect": "Allow",
              "Action": "logs:DescribeLogGroups",
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:CreateRole",
                "iam:PutRolePolicy"
              ],
              "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-PreviewRole-*",
              "Condition": {
                "ArnEquals": {
                  "iam:PermissionsBoundary": "arn:aws:iam::058264289478:policy/ProjectRespawn-Tournaments-Ntgre-RuntimeBoundary"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListRolePolicies",
                "iam:ListAttachedRolePolicies",
                "iam:DeleteRole",
                "iam:DeleteRolePolicy",
                "iam:UpdateRole",
                "iam:UpdateRoleDescription",
                "iam:UpdateAssumeRolePolicy",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:ListRoleTags"
              ],
              "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-PreviewRole-*"
            },
            {
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-PreviewRole-*",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "lambda.amazonaws.com"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
              ],
              "Resource": [
                "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json",
                "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/004def9c2189ea71a43cc3a05a796073327c0a084a7d896d0d6ee19aa8e54199.zip"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters"
              ],
              "Resource": "arn:aws:ssm:eu-north-1:058264289478:parameter/cdk-bootstrap/hnb659fds/version"
            },
            {
              "Effect": "Deny",
              "Action": [
                "apigateway:*",
                "lambda:*",
                "logs:*",
                "cloudwatch:*"
              ],
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:RequestedRegion": "eu-north-1"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "apigateway:GET",
                "apigateway:PATCH",
                "apigateway:DELETE"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "apigateway:GET",
                "apigateway:POST",
                "apigateway:PATCH",
                "apigateway:DELETE"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/authorizers"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/authorizers/*"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/integrations"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/integrations/*"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/routes"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/routes/*"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/stages"
                },
                {
                  "Fn::Sub": "arn:aws:apigateway:eu-north-1::/apis/${TournamentApiId}/stages/*"
                }
              ]
            },
            {
              "Effect": "Deny",
              "Action": [
                "logs:PutResourcePolicy",
                "logs:DeleteResourcePolicy",
                "logs:CreateLogDelivery",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery"
              ],
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Action": [
                "apigateway:POST",
                "apigateway:PATCH",
                "apigateway:PUT"
              ],
              "Resource": [
                "arn:aws:apigateway:eu-north-1::/apis/*/stages",
                "arn:aws:apigateway:eu-north-1::/apis/*/stages/*"
              ],
              "Condition": {
                "Null": {
                  "apigateway:Request/AccessLoggingDestination": "false"
                }
              }
            }
          ]
        }
      }
    },
    "RuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "ProjectRespawn-Tournaments-Ntgre-RuntimeBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyEverythingExceptLogging",
              "Effect": "Deny",
              "NotAction": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": "*"
            },
            {
              "Sid": "DenyOtherLogs",
              "Effect": "Deny",
              "Action": "logs:*",
              "NotResource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/tournaments/preview:*"
            },
            {
              "Sid": "OnlyPreviewLogs",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/tournaments/preview:*"
            }
          ]
        }
      }
    },
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "ProjectRespawn-Tournaments-Ntgre-Deploy",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::058264289478:user/RavenTest"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Ref": "DeploymentPolicy"
          }
        ],
        "PermissionsBoundary": {
          "Ref": "DeploymentPolicy"
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "ProjectRespawn-Tournaments-Ntgre-CfnExecution",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Ref": "ExecutionPolicy"
          }
        ],
        "PermissionsBoundary": {
          "Ref": "ExecutionPolicy"
        }
      }
    }
  },
  "Metadata": {
    "Status": "READY_FOR_BOOTSTRAP_AUTHORIZATION_NOT_DEPLOYED",
    "SelectedOutcome": "DEFER_API_ACCESS_LOGGING",
    "Account": "058264289478",
    "Region": "eu-north-1",
    "ProductRevision": "b75a91494c03606d825e234a65d295c184067820cd77dfc84e11a2c83484ae2f",
    "ProductTemplateSha256": "b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705",
    "AwsWritesAuthorized": false
  }
}
