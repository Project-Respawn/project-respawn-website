{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEverythingExceptLogging",
      "Effect": "Deny",
      "NotAction": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherLogs",
      "Effect": "Deny",
      "Action": "logs:*",
      "NotResource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/tournaments/preview:*"
    },
    {
      "Sid": "OnlyPreviewLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-north-1:058264289478:log-group:/project-respawn/Ntgre/tournaments/preview:*"
    }
  ]
}
