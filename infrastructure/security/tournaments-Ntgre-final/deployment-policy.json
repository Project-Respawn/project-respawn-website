{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyReviewedOperations",
      "Effect": "Deny",
      "NotAction": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "iam:PassRole",
        "sts:GetCallerIdentity",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyEveryOtherStack",
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "NotResource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*"
    },
    {
      "Sid": "DenyWrongCfnRegion",
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "InspectOnlyTournament",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets"
      ],
      "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*"
    },
    {
      "Sid": "PrepareOnlyReviewedTemplate",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution"
        },
        "StringEquals": {
          "cloudformation:TemplateUrl": "https://cdk-hnb659fds-assets-058264289478-eu-north-1.s3.eu-north-1.amazonaws.com/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "ntgre-tournaments-*"
        }
      }
    },
    {
      "Sid": "ManageOnlyTournamentChangeSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:eu-north-1:058264289478:stack/ProjectRespawn-Tournaments-Ntgre/*",
      "Condition": {
        "StringLike": {
          "cloudformation:ChangeSetName": "ntgre-tournaments-*"
        }
      }
    },
    {
      "Sid": "DenyPassingOtherRoles",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "NotResource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution"
    },
    {
      "Sid": "DenyPassingToOtherServices",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassOnlyTournamentExecution",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::058264289478:role/ProjectRespawn-Tournaments-Ntgre-CfnExecution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadOnlyApprovedTemplate",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json"
    },
    {
      "Sid": "DenyOtherArtifactReads",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": "arn:aws:s3:::cdk-hnb659fds-assets-058264289478-eu-north-1/b9be81faba86a3a8e1949cca1c802720a7bf557cc74cd6cb7f5ee17423c35705.json"
    },
    {
      "Sid": "ReadBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:eu-north-1:058264289478:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "CallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "cognito-idp:*",
        "cognito-identity:*",
        "appsync:*",
        "dynamodb:*",
        "kms:*",
        "secretsmanager:*",
        "ecs:*",
        "ec2:*",
        "events:*",
        "firehose:*"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "logs:PutResourcePolicy",
        "logs:DeleteResourcePolicy",
        "logs:CreateLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery"
      ],
      "Resource": "*"
    }
  ]
}
