{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "domain-endpoints.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "domain", "domainOwner", "environment", "account", "region", "stackName", "stackArn", "apiId", "endpoint", "status", "authMode", "contractVersion", "deploymentRevision", "provenance"],
  "properties": {
    "manifestVersion": {"const": "domain-endpoints.v1"},
    "domain": {"type": "string", "minLength": 1},
    "domainOwner": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "account": {"type": "string", "pattern": "^[0-9]{12}$"},
    "region": {"type": "string", "minLength": 1},
    "stackName": {"type": "string", "minLength": 1},
    "stackArn": {"type": "string", "pattern": "^arn:aws:cloudformation:[a-z0-9-]+:[0-9]{12}:stack/[^/]+/[^/]+$"},
    "apiId": {"type": "string", "pattern": "^[a-z0-9]+$"},
    "endpoint": {"type": "string", "pattern": "^https://[a-z0-9]+\\.execute-api\\.[a-z0-9-]+\\.amazonaws\\.com$"},
    "status": {"const": "DEPLOYED"},
    "authMode": {"const": "COGNITO_JWT_ACCESS_TOKEN"},
    "contractVersion": {"type": "string", "minLength": 1},
    "deploymentRevision": {"$ref": "#/definitions/sha"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "coreSha256", "templateSha256", "lambdaCodeSha256", "liveVerified", "authenticatedAt", "acceptedAt", "runtimeRequestId", "report", "frontendCutover"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "coreSha256": {"$ref": "#/definitions/sha"},
        "templateSha256": {"$ref": "#/definitions/sha"},
        "lambdaCodeSha256": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
        "liveVerified": {"const": true},
        "authenticatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
        "acceptedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
        "runtimeRequestId": {"type": "string", "minLength": 1},
        "report": {"type": "string", "pattern": "^docs/architecture/[^.][^:]*\\.md$"},
        "frontendCutover": {"type": "boolean"}
      }
    }
  },
  "definitions": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
